{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "strict": true,
    "noImplicitAny": true,
    "outDir": "./js",
    "rootDir": "./ts",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "forceConsistentCasingInFileNames": true,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["ts/**/*.ts"]
}
